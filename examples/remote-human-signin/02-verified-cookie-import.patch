+    def import_cookies(self,
+                       cookies: object) -> None:
+        """Verify browser cookies in an isolated session, then atomically publish them.
+
+        Only cookies for this Amazon site are accepted. Verification failure leaves the previous
+        cookie jar and in-memory session untouched. A jar replaced during verification is refused.
+        Callers must serialize publication with other writers; the file lock coordinates threads
+        in this process, not independent processes. No credentials or sign-in forms are used.
+        """
+        domain = (urlparse(self.config.constants.BASE_URL).hostname or "").removeprefix("www.")
+        if not isinstance(cookies, list) or not cookies:
+            raise AmazonOrdersAuthError("No browser session was supplied.")
+        for cookie in cookies:
+            if not isinstance(cookie, dict) or not all(isinstance(cookie.get(k), str) for k in
+                                                       ("name", "value", "domain")):
+                raise AmazonOrdersAuthError("Invalid browser session.")
+            host = cookie["domain"].lstrip(".").lower()
+            if host != domain and not host.endswith("." + domain):
+                raise AmazonOrdersAuthError("Browser cookies belong to another site.")
+
+        def revision() -> Optional[Tuple[int, int, int, int]]:
+            try:
+                stat = os.stat(self.config.cookie_jar_path)
+                return stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns
+            except FileNotFoundError:
+                return None
+
+        with cookies_file_lock:
+            previous_revision = revision()
+        with tempfile.TemporaryDirectory(prefix="amazon-session-") as directory:
+            config = copy.deepcopy(self.config)
+            config.cookie_jar_path = os.path.join(directory, "cookies.json")
+            if config.cookie_jar_path != os.path.join(directory, "cookies.json"):
+                raise AmazonOrdersError("The cookie jar environment override prevents isolated verification.")
+            candidate = AmazonSession(config=config, io=self.io)
+            try:
+                candidate.session.cookies.clear()
+                candidate._load_cookie_jar_data(cookies)
+                if not candidate.check_session(verify=True):
+                    raise AmazonOrdersAuthError("Amazon did not accept the browser session.")
+                with cookies_file_lock:
+                    if revision() != previous_revision:
+                        raise AmazonOrdersAuthError("The saved session changed during verification; retry the import.")
+                    previous_cookies = self.session.cookies
+                    self.session.cookies = candidate.session.cookies.copy()
+                    try:
+                        self._write_cookie_jar()
+                    except BaseException:
+                        self.session.cookies = previous_cookies
+                        raise
+                    self.is_authenticated = True
+                    self._sign_in_required = False
+            finally:
+                candidate.session.close()
+
