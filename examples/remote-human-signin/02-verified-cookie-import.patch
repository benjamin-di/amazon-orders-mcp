 or a `pull request <https://github.com/alexdlaird/amazon-orders/compare>`_.
+
+Importing a Browser Session
+--------------------------
+
+An application with its own browser can call ``amazon_session.import_cookies(cookies)``
+with Playwright-shaped cookie dictionaries. Only the active site's cookies are accepted.
+The method verifies the candidate in a temporary session before atomically replacing
+the normal jar and activating it in memory. Verification and saving failures preserve
+the previous session. A jar replaced during verification is refused.
+
+Serialize this call with other session writers. The existing cookie-file lock protects
+threads in this process; it is not a cross-process transaction. Applications must also
+reject superseded attempts before invoking publication. No credentials or sign-in forms
+are used by this method.
diff --git a/tests/unit/test_import_cookies.py b/tests/unit/test_import_cookies.py
new file mode 100644
index 0000000..b04e632
--- /dev/null
+++ b/tests/unit/test_import_cookies.py
@@ -0,0 +1,94 @@
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import responses
+
+from amazonorders.conf import AmazonOrdersConfig
+from amazonorders.exception import AmazonOrdersAuthError, AmazonOrdersError
+from amazonorders.session import AmazonSession
+
+
+class TestImportCookies(unittest.TestCase):
+    def setUp(self):
+        environment = {k: v for k, v in os.environ.items() if not k.startswith("AMAZON_")}
+        self.environment = patch.dict(os.environ, environment, clear=True)
+        self.environment.start()
+        self.addCleanup(self.environment.stop)
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.jar = Path(self.directory.name) / "cookies.json"
+        self.config = AmazonOrdersConfig(data={"cookie_jar_path": str(self.jar)})
+        self.cookies = [{"name": name, "value": "synthetic-new", "domain": ".amazon.com"}
+                        for name in self.config.constants.COOKIES_SET_WHEN_AUTHENTICATED]
+        self.old = [{**c, "value": "synthetic-old"} for c in self.cookies]
+        self.jar.write_text(json.dumps(self.old))
+        self.session = AmazonSession(config=self.config)
+        self.addCleanup(self.session.session.close)
+
+    @responses.activate
+    def test_verified_session_is_published_and_readable_by_a_fresh_session(self):
+        responses.get(self.config.constants.ORDER_HISTORY_URL, body="<html>Orders</html>")
+        self.session._sign_in_required = True
+        self.session.import_cookies(self.cookies)
+        fresh = AmazonSession(config=self.config)
+        self.addCleanup(fresh.session.close)
+        self.assertTrue(fresh.check_session())
+        self.assertTrue(self.session.is_authenticated)
+        self.assertFalse(self.session._sign_in_required)
+        self.assertEqual("synthetic-new", fresh.session.cookies.get(self.cookies[0]["name"], domain=".amazon.com"))
+        self.assertEqual(0o600, self.jar.stat().st_mode & 0o777)
+
+    @responses.activate
+    def test_verification_failure_preserves_the_old_session(self):
+        responses.get(self.config.constants.ORDER_HISTORY_URL, status=503)
+        before = self.jar.read_bytes()
+        with self.assertRaises(AmazonOrdersError):
+            self.session.import_cookies(self.cookies)
+        self.assertEqual(before, self.jar.read_bytes())
+        self.assertEqual("synthetic-old", self.session.session.cookies.get(self.cookies[0]["name"]))
+
+    @responses.activate
+    def test_concurrent_publication_is_not_overwritten(self):
+        newer = json.dumps([{**c, "value": "synthetic-newer"} for c in self.cookies])
+
+        def replace(request):
+            replacement = self.jar.with_suffix(".new")
+            replacement.write_text(newer)
+            replacement.replace(self.jar)
+            return 200, {}, "<html>Orders</html>"
+
+        responses.add_callback(responses.GET, self.config.constants.ORDER_HISTORY_URL, callback=replace)
+        with self.assertRaisesRegex(AmazonOrdersAuthError, "changed during verification"):
+            self.session.import_cookies(self.cookies)
+        self.assertEqual(newer, self.jar.read_text())
+
+    @responses.activate
+    def test_foreign_cookies_are_refused_without_a_request(self):
+        with self.assertRaisesRegex(AmazonOrdersAuthError, "another site"):
+            self.session.import_cookies([{**self.cookies[0], "domain": ".amazon.de"}])
+        self.assertEqual([], list(responses.calls))
+
+    @responses.activate
+    def test_failed_save_keeps_the_original_memory_and_disk(self):
+        responses.get(self.config.constants.ORDER_HISTORY_URL, body="<html>Orders</html>")
+        before = self.jar.read_bytes()
+        with patch("amazonorders.session.os.replace", side_effect=OSError("synthetic disk failure")):
+            with self.assertRaises(OSError):
+                self.session.import_cookies(self.cookies)
+        self.assertEqual(before, self.jar.read_bytes())
+        self.assertEqual("synthetic-old", self.session.session.cookies.get(self.cookies[0]["name"]))
+
+    @responses.activate
+    def test_an_environment_jar_cannot_bypass_isolation(self):
+        with patch.dict(os.environ, {"AMAZON_COOKIE_JAR_PATH": str(self.jar)}):
+            configured = AmazonOrdersConfig()
+            session = AmazonSession(config=configured)
+            self.addCleanup(session.session.close)
+            before = self.jar.read_bytes()
+            with self.assertRaisesRegex(AmazonOrdersError, "override"):
+                session.import_cookies(self.cookies)
+            self.assertEqual(before, self.jar.read_bytes())
