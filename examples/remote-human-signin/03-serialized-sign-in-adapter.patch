diff --git a/tests/unit/test_sign_in_adapter.py b/tests/unit/test_sign_in_adapter.py
new file mode 100644
index 0000000..c7383f4
--- /dev/null
+++ b/tests/unit/test_sign_in_adapter.py
@@ -0,0 +1,57 @@
+import threading
+
+from amazonorders.exception import AmazonOrdersAuthError
+
+from tests.unittestcase import UnitTestCase
+
+
+class TestSignInAdapter(UnitTestCase):
+    def test_signed_out_session_can_be_passed_to_an_adapter(self):
+        seen = []
+
+        def login(session):
+            seen.append(session.config.site)
+            session.is_authenticated = True
+
+        self.saved_session.sign_in_with(login, "amazon.de")
+        self.assertEqual(["amazon.de"], seen)
+        self.assertEqual("amazon.com", self.saved_session.site())
+
+    def test_unverified_completion_is_refused_and_lock_is_released(self):
+        with self.assertRaises(AmazonOrdersAuthError):
+            self.saved_session.sign_in_with(lambda session: None)
+        self.test_signed_out_session_can_be_passed_to_an_adapter()
+
+    def test_another_call_to_the_same_site_waits_for_the_adapter(self):
+        entered, release, finished = threading.Event(), threading.Event(), threading.Event()
+        errors = []
+
+        def first_login(session):
+            entered.set()
+            if not release.wait(3):
+                raise AssertionError("adapter never released")
+            session.is_authenticated = True
+
+        def second_login(session):
+            finished.set()
+            session.is_authenticated = True
+
+        def call(login):
+            try:
+                self.saved_session.sign_in_with(login)
+            except BaseException as error:
+                errors.append(error)
+
+        first = threading.Thread(target=call, args=(first_login,))
+        second = threading.Thread(target=call, args=(second_login,))
+        first.start()
+        self.assertTrue(entered.wait(3))
+        second.start()
+        try:
+            self.assertFalse(finished.wait(0.05))
+        finally:
+            release.set()
+            first.join(3)
+            second.join(3)
+        self.assertTrue(finished.is_set())
+        self.assertEqual([], errors)
