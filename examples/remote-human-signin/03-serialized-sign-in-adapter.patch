@@ -142,6 +142,25 @@ class SavedSession:
 
         return site_session.sign_in_status if site_session else WAITING_TO_SIGN_IN_STATUS
 
+    def sign_in_with(self,
+                     login: Callable[[AmazonSession], None],
+                     site: Optional[str] = None) -> None:
+        """Run an application's sign-in adapter under this site's normal tool lock.
+
+        The adapter receives the site's session even when signed out, and must verify and
+        publish a session before returning. Other calls to this site wait; different sites
+        remain independent. This method starts no browser and chooses no login mechanism.
+        """
+        site_session = self._site_session(site)
+        with site_session.lock:
+            amazon_session = site_session._session()
+            try:
+                login(amazon_session)
+                if not amazon_session.is_authenticated:
+                    raise AmazonOrdersAuthError("The sign-in adapter did not establish a verified session.")
+            finally:
+                site_session._loaded_cookie_jar_mtime = amazon_session.cookie_jar_mtime
+
