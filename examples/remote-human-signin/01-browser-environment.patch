diff --git a/tests/unit/contrib/test_browser_environment.py b/tests/unit/contrib/test_browser_environment.py
new file mode 100644
index 0000000..16a7748
--- /dev/null
+++ b/tests/unit/contrib/test_browser_environment.py
@@ -0,0 +1,39 @@
+import os
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from amazonorders.contrib.browser.playwright import PlaywrightBrowserLauncher, PlaywrightBrowserLogin
+from amazonorders.exception import AmazonOrdersError
+
+
+class TestBrowserEnvironment(unittest.TestCase):
+    @patch("amazonorders.contrib.browser.playwright.sys.platform", "linux")
+    def test_display_preflight_uses_the_supplied_child_environment(self):
+        login = PlaywrightBrowserLogin(SimpleNamespace(config=None))
+        with patch.dict(os.environ, {"DISPLAY": ""}, clear=True):
+            with patch.object(login, "launch_env", return_value={"DISPLAY": ":123"}):
+                login._require_display()
+        with patch.dict(os.environ, {"DISPLAY": ":88"}):
+            with patch.object(login, "launch_env", return_value={}):
+                with self.assertRaises(AmazonOrdersError):
+                    login._require_display()
+
+    def test_default_browser_receives_child_environment_without_mutating_parent(self):
+        config = SimpleNamespace(browser=None, browser_executable_path=None)
+        playwright = SimpleNamespace(chromium=MagicMock())
+        environment = {"DISPLAY": ":123", "PATH": "/usr/bin"}
+        with patch.dict(os.environ, {"DISPLAY": ":88"}):
+            PlaywrightBrowserLauncher(config).launch(playwright, False, env=environment)
+            self.assertEqual(":88", os.environ["DISPLAY"])
+        self.assertEqual(environment, playwright.chromium.launch.call_args.kwargs["env"])
+
+    def test_selected_executable_receives_environment_and_defaults_still_inherit(self):
+        config = SimpleNamespace(browser="chromium", browser_executable_path="/synthetic/chrome")
+        browser_type = MagicMock()
+        launcher = PlaywrightBrowserLauncher(config)
+        with patch.object(launcher, "_browser_types", return_value={"chromium": browser_type}):
+            launcher.launch(object(), False, env={"DISPLAY": ":123"})
+            self.assertEqual({"DISPLAY": ":123"}, browser_type.launch.call_args.kwargs["env"])
+            launcher.launch(object(), False)
+            self.assertNotIn("env", browser_type.launch.call_args.kwargs)
